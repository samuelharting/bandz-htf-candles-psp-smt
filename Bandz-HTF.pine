//@version=6
// © 2026 Bandz
// Bandz HTF Context organizes higher-timeframe candle structure, range location,
// intermarket confirmation, liquidity reactions, and rejection zones in one workflow.

indicator(
     "Bandz HTF",
     shorttitle = "Bandz HTF",
     overlay = true,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500,
     dynamic_requests = true)

// Object limits are shared by every enabled module. These internal budgets keep
// the worst-case configuration below TradingView's 500-object limits.
const int SMT_LINE_BUDGET = 120
const int TEMPLATE_LINE_BUDGET = 70
const int TEMPLATE_BOX_BUDGET = 120
const int REJECTION_ZONE_BOX_BUDGET = 30
const int RANGE_FUTURE_RESERVE = 34
const int RANGE_STANDALONE_WIDTH = 9
const int RANGE_STANDALONE_GAP = 4

